meta {
  name: Register user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Bruno",
    "lastName": "Testeur",
    "email": "{{testUserEmail}}",
    "password": "{{testUserPassword}}"
  }
}

script:pre-request {
  // Généré dynamiquement pour ne jamais entrer en conflit avec un compte déjà existant.
  const uniqueEmail = `bruno.test.${Date.now()}@example.com`;
  bru.setVar("testUserEmail", uniqueEmail);
  bru.setVar("testUserPassword", "password123");
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("userToken", res.body.accessToken);
  }
}

tests {
  test("retourne 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("renvoie un accessToken et un refreshToken", function () {
    expect(res.body).to.have.property("accessToken");
    expect(res.body).to.have.property("refreshToken");
    expect(res.body.accessToken).to.be.a("string").and.not.empty;
  });
}
