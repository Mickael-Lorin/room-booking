meta {
  name: Login bad credentials -> 401
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "mauvais-mot-de-passe"
  }
}

tests {
  test("retourne 401 UNAUTHORIZED", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("message générique sans fuite d'info", function () {
    expect(res.body.message).to.contain("incorrect");
  });
}
