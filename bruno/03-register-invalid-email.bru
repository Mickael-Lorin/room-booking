meta {
  name: Register invalid email -> 400
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Bruno",
    "lastName": "Invalide",
    "email": "pas-un-email",
    "password": "password123"
  }
}

tests {
  test("retourne 400 BAD REQUEST", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("message signale le champ email", function () {
    expect(res.body.message).to.contain("email");
  });
}
