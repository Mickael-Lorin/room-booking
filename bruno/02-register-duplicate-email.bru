meta {
  name: Register duplicate email -> 409
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Bruno",
    "lastName": "Bis",
    "email": "{{testUserEmail}}",
    "password": "{{testUserPassword}}"
  }
}

tests {
  test("retourne 409 CONFLICT", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("message indique un compte déjà existant", function () {
    expect(res.body.message).to.contain("existe déjà");
    expect(res.body.message).to.contain(bru.getVar("testUserEmail"));
  });
}
